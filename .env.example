# KisanSamvaad - Environment Configuration Template
# Copy this file to .env and configure your credentials

# Application Environment (development, testing, production)
APP_ENV=production

# Server Network Binding
HOST=127.0.0.1
PORT=8000

# Supabase BaaS Cloud Infrastructure
# Public URL and Anonymous Key are safe to expose to client browsers
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (STRICTLY CONFIDENTIAL)
# NEVER expose this key in client-side code, git repos, or browser bundles.
# Used exclusively for server-side trusted processes and migrations.
SUPABASE_SERVICE_ROLE_KEY=

# Production & Vercel Dynamic Redirect URL Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:8000
# NEXT_PUBLIC_VERCEL_URL is automatically populated by Vercel for preview branches

# Sarvam AI Sovereign Indic API Key (Optional)
# Leave empty or set to placeholder to run in calibrated offline ICAR simulation mode.
# When provided, activates live Saaras ASR, Bulbul TTS, Sarvam-1 LLM, and Document Vision.
SARVAM_API_KEY=

# Sarvam Base Endpoint
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_TIMEOUT_SECONDS=10

# Agricultural Safety & Scientific Guardrails
# When true, strictly intercepts banned chemicals (Endosulfan, Paraquat) and limits dosage
STRICT_ICAR_SAFETY=true

# SQLite Relational Database Storage Path (Fallback/Local Mode)
DATABASE_PATH=backend/kisansamvaad.db

# Cache Invalidation Controls (Minutes)
MANDI_CACHE_TTL_MINUTES=15
WEATHER_REFRESH_HOURS=3
