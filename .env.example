# KisanSamvaad - Sovereign Indic Voice & Document AI for Indian Agriculture
# Configuration & Environment Variables

# Sarvam AI API Subscription Key
# Obtain from: https://dashboard.sarvam.ai
# If left blank, the application operates in calibrated offline demonstration mode
SARVAM_API_KEY=your_sarvam_api_key_here

# Sarvam API Base URL
SARVAM_BASE_URL=https://api.sarvam.ai

# Server Host and Port
HOST=127.0.0.1
PORT=8000

# Application Environment (development, testing, production)
APP_ENV=production

# Strict ICAR Agronomic Safety Enforcement
# When true, all agrochemical recommendations pass through deterministic guardrails
STRICT_ICAR_SAFETY=true

# Request Timeout in Seconds
SARVAM_TIMEOUT_SECONDS=10

